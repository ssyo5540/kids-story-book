# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
# >= 32 random chars (`openssl rand -hex 32`). Admin routes answer 404 while unset.
ADMIN_TOKEN=

# ---------- Content ----------
CONTENT_DIR=content
# Show needs_review translations (local/staging only)
CONTENT_INCLUDE_UNREVIEWED=true

# ---------- Storage ----------
# local: files under LOCAL_STORAGE_DIR served by /blob/*   |  gcs: Google Cloud Storage bucket
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
GCS_BUCKET=
PUBLIC_AUDIO_BASE_URL=
GCP_PROJECT_ID=
# Service-account JSON (raw or base64). Server/CI only. Never NEXT_PUBLIC_.
GCP_SA_KEY_JSON=

# ---------- Text-to-Speech guardrails ----------
# fake = silent audio, zero cost (default). google = Chirp 3 HD (needs credentials).
TTS_DRIVER=fake
TTS_ENABLED=true
TTS_LAZY_ENABLED=true
TTS_MONTHLY_CHAR_BUDGET=900000
TTS_DAILY_CHAR_BUDGET=150000
TTS_WRITER_ID=server
TTS_MAX_RPM=100
TTS_CONCURRENCY=3
JOBS_CONCURRENCY=2
TTS_SPEAKING_RATE=0.9
TTS_MAX_CHUNK_BYTES=4500
TTS_MAX_CHUNK_EST_SECONDS=60
TTS_CUSTOM_PRONUNCIATION_LOCALES=en-US,en-GB,en-IN
PUBLIC_GENERATION_PER_IP_PER_DAY=3
PUBLIC_GENERATION_GLOBAL_PER_DAY=20

# ---------- Audio encode ----------
AUDIO_MP3_BITRATE=56
AUDIO_NORMALIZE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
