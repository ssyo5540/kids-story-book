{
  "name": "nightlight-tales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:validate && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/content-validate.ts",
    "audio:generate": "tsx scripts/audio-generate.ts",
    "audio:previews": "tsx scripts/audio-previews.ts",
    "audio:sample": "tsx scripts/audio-sample.ts",
    "audio:status": "tsx scripts/audio-status.ts",
    "audio:gc": "tsx scripts/audio-gc.ts",
    "docker:build": "docker build -t nightlight-tales .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local nightlight-tales",
    "assets:make": "tsx scripts/make-assets.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@serwist/range-requests": "^9.5.12",
    "@tanstack/react-query": "^5.102.8",
    "gray-matter": "^4.0.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.62.1",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "railway": "^3.11.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  }
}
